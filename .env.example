# Supabase (required for the seed script; the app itself runs with mock
# data even without these, but real persistence needs them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — without these the app falls back to unauthenticated Google
# Books requests and deterministic mock BookScouter prices, so you can run
# and demo everything before signing up for either.
GOOGLE_BOOKS_API_KEY=
BOOKSCOUTER_API_KEY=

# Optional — powers live price + photo lookup for the mini fridge and
# microwave dorm items only (Best Buy's catalog doesn't cover the rest).
# Without it, those two items fall back to curated demo data like everything
# else. Free self-serve key: https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Optional — powers the plain-language "buy now vs wait" explanation.
# Without it, a templated fallback explanation is used instead.
ANTHROPIC_API_KEY=
