# Supabase (required for the seed script; the app itself runs with mock
# data even without these, but real persistence needs them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Book metadata (title, author, cover) comes from the Open Library API,
# free and public, no key ever needed.

# Optional — real cross-vendor textbook pricing via SerpApi's Google
# Shopping engine. Free tier (250 searches/month), self-serve, no approval
# wait: https://serpapi.com/users/sign_up. Without it, textbook prices
# fall back to a deterministic mock generator (clearly labeled in the UI).
SERPAPI_KEY=

# Optional, secondary fallback — BookScouter also does real cross-vendor
# textbook pricing, tried only if SerpApi returns nothing. Requires a
# developer-tier application at https://bookscouter.com (this project's
# own application was rejected, which is why SerpApi is the primary path).
BOOKSCOUTER_API_KEY=

# Optional — powers live price + photo lookup for the mini fridge and
# microwave dorm items only (Best Buy's catalog doesn't cover the rest).
# Without it, those two items fall back to curated demo data like everything
# else. Free self-serve key: https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Optional — powers the plain-language "buy now vs wait" explanation.
# Without it, a templated fallback explanation is used instead.
ANTHROPIC_API_KEY=
